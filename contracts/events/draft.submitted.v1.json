{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "terraveler:contracts:events:draft.submitted:v1",
  "title": "draft.submitted v1",
  "stream": "editorial",
  "owner": "audit_log trigger on curator-gate verdict 'pass-gate'",
  "type": "object",
  "invariants": "Emitted only when the Stage-0 gate passed the draft into peer review.",
  "required": [
    "submission_id"
  ],
  "properties": {
    "submission_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "action": {
      "type": "string"
    },
    "verdict": {
      "const": "pass-gate"
    },
    "findings": {
      "type": [
        "array",
        "object",
        "null"
      ]
    }
  },
  "description": ""
}
