{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "terraveler:contracts:events:verdict.issued:v1",
  "title": "verdict.issued v1",
  "stream": "editorial",
  "owner": "audit_log trigger on action 'verdict', actor editor-in-chief | curator-desk",
  "type": "object",
  "invariants": "An approving verdict presupposes the review dossier (Carta §10.4); the guard lives in the verdict paths, upstream of the ledger.",
  "required": [
    "submission_id",
    "verdict"
  ],
  "properties": {
    "submission_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "action": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "approve",
        "reject",
        "changes-requested"
      ]
    },
    "findings": {
      "type": [
        "array",
        "object",
        "null"
      ]
    }
  },
  "description": ""
}
