{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "terraveler:contracts:events:submission.published:v1",
  "title": "submission.published v1",
  "stream": "editorial",
  "owner": "audit_log trigger on action 'publish'",
  "type": "object",
  "invariants": "Presupposes an approved verdict on the same submission and a provenance block in the bundle.",
  "required": [
    "submission_id"
  ],
  "properties": {
    "submission_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "action": {
      "type": "string"
    },
    "verdict": {
      "type": [
        "string",
        "null"
      ]
    },
    "findings": {
      "type": [
        "array",
        "object",
        "null"
      ]
    }
  },
  "description": ""
}
