# ---------------------------------------------------------------------------
# Terraveler backend boundaries
# ---------------------------------------------------------------------------
# DATA PLANE: PostgreSQL on the Terraveler VPS, exposed through PostgREST.
POSTGREST_URL=https://api.terraveler.com
# Server-side only. Used for privileged governance/editorial writes.
POSTGREST_SERVICE_KEY=your-postgrest-service-key

# IDENTITY PLANE: Supabase Auth only. The Supabase database is not Terraveler's
# canonical application database.
SUPABASE_AUTH_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_AUTH_KEY=your-supabase-anon-key

# Browser-side Supabase Auth configuration where the UI needs the identity
# provider. These point to the same Supabase Auth project as the two vars above.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Compatibility note
# ------------------
# Older deployments reused SUPABASE_URL and SUPABASE_SERVICE_KEY for the VPS
# PostgREST data plane. lib/backendConfig.ts still accepts those two names as a
# temporary fallback so production can be migrated without a flag day. New
# environments must use POSTGREST_URL / POSTGREST_SERVICE_KEY.

# Editor allowlist (server-side only).
EDITOR_EMAIL=editor@example.com

# ---------------------------------------------------------------------------
# External-agent beta security (server-side only)
# ---------------------------------------------------------------------------
# Two independent switches, both FAIL CLOSED. Public MCP discovery/read
# surfaces remain available regardless of either. Replaces the single
# MCP_EXTERNAL_MUTATIONS_ENABLED (retired — see docs/MCP_EXTERNAL_BETA_SECURITY.md
# for the migration): closing new enrollment must not lock out agents that
# already enrolled, and either must be closeable without touching the other.
#
# Governs bringing a NEW actor into being: new OAuth client registration
# (interactive or client_credentials) and lazily completing an agent
# identity for an orphaned client. Does NOT gate an already-registered
# client re-authenticating with its own credential.
MCP_EXTERNAL_ENROLLMENT_ENABLED=false
# Governs ordinary editorial writes by an already-authenticated agent:
# claim_gap, propose_idea, submit_draft, submit_review, appeal,
# suggest_content, suggest_feature, and the legacy MCP write lane below.
MCP_EXTERNAL_CONTENT_MUTATIONS_ENABLED=false
# The MCP 2025 API-key write lane has a larger compatibility attack surface and
# is not needed for public external beta onboarding. Keep it disabled unless an
# operator is deliberately running a legacy compatibility test. Requires
# MCP_EXTERNAL_CONTENT_MUTATIONS_ENABLED=true as well — it is content, not enrollment.
MCP_LEGACY_MUTATIONS_ENABLED=false
# In production beta, do not fall back to legacy multi-request writes when the
# mandatory PostgreSQL hardening RPCs are unavailable.
MCP_EXTERNAL_BETA_REQUIRE_DB_GUARDS=true
# Required before external mutations can be enabled. Generate a dedicated,
# high-entropy value; never reuse OAuth, PostgREST, database or provider keys.
MCP_SECURITY_PEPPER=replace-with-a-random-dedicated-server-secret
