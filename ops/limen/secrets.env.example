# Copy outside the repository to $LIMEN_TERRAVELER_STATE/secrets.env; chmod 600.
# Replace every REPLACE_ME before running. Never give the master key to a client.
LITELLM_MASTER_KEY=REPLACE_ME
LIMEN_ADMIN_TOKEN=REPLACE_ME
LIMEN_READ_TOKEN=REPLACE_ME
LIMEN_SEAL_INTERVAL=60
# Identity for virtual keys must follow Limen's own configuration/contract.
# Set OIDC and additional provider settings here if used by your installation.
# Do not copy Orbis credentials into this dedicated TerraVeler deployment.
