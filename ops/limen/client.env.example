# Next.js server variables; never NEXT_PUBLIC_* and never committed with values.
EDITOR_LOCAL_AI_PROVIDER=limen
# Next.js on Vercel needs a protected TLS reverse proxy, not this Docker hostname.
EDITOR_LIMEN_BASE_URL=https://REPLACE_ME/v1
EDITOR_LIMEN_API_KEY=REPLACE_ME_WITH_SCOPED_VIRTUAL_KEY
EDITOR_LIMEN_MODEL=local-default
# Create this class as local_only in Limen and authorize it for the virtual key.
EDITOR_LIMEN_DATA_CLASS=editorial
