# Copy outside git; pass this file to scripts/limen-stack.sh.
# Root compose also reads TerraVeler's existing .env; keep it unchanged.
LIMEN_TERRAVELER_STATE=/absolute/path/to/terraveler-limen-state
LIMEN_DB_PASSWORD=REPLACE_ME
# URL-encode the SAME database password; this is the separate Limen database.
LIMEN_DATABASE_URL=postgresql://limen:REPLACE_ME@terraveler_limen_db:5432/limen
