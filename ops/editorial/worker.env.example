# Copy outside the repository; chmod 600. These are placeholders, not credentials.
# Both gates must explicitly become 1 before work/model calls are permitted.
EDITORIAL_WORKER_ENABLED=0
EDITORIAL_HANDLERS_ENABLED=0
EDITORIAL_WORKER_ID=editorial-worker-1
EDITORIAL_HANDLER_ROLES=research,writer,reviewer

# Canonical VPS application PostgreSQL, NOT Supabase Auth or Limen's database.
# Use a dedicated LOGIN granted the worker privileges described in the runbook.
PGHOST=terraveler_postgres
PGPORT=5432
PGDATABASE=terraveler
PGUSER=terraveler_editorial_worker
PGPASSWORD=replace-with-worker-password
PGCONNECT_TIMEOUT=5
PGOPTIONS=-c statement_timeout=5000 -c lock_timeout=3000

# Docker DNS works only when compose.limen.yml is on the same terraveler network.
# Scoped Limen virtual key only; never use a provider/master/admin key here.
EDITOR_LIMEN_BASE_URL=http://terraveler_limen:4000
EDITOR_LIMEN_API_KEY=replace-with-scoped-virtual-key
EDITOR_LIMEN_DATA_CLASS=replace-with-authorized-data-class
# Bounded production worker defaults; no automatic retry or provider fallback.
# Timeout values above 120 and up to 900 seconds leave margin within the 1000-second task deadline.
EDITOR_LIMEN_TIMEOUT_SECONDS=900
EDITOR_LIMEN_MAX_TOKENS=4096
EDITOR_LIMEN_MODEL=local-default
# Optional JSON map of additional exact aliases to their own scoped keys.
# Never reuse the default key or use a shared group that forces local-default.
# EDITOR_LIMEN_MODEL_KEYS={}

# Optional governed MCP corpus path; never enable until server uses the same
# dedicated key and EDITORIAL_MCP_CORPUS_WORKER_ID matches EDITORIAL_WORKER_ID.
EDITORIAL_MCP_CORPUS_ENABLED=0
EDITORIAL_MCP_URL=https://www.terraveler.com/api/mcp
EDITORIAL_MCP_CORPUS_KEY=replace-with-dedicated-random-worker-key

# Rank each research read by the work item's own question (editorial_research_relevance.sql).
# Enable only after that migration and the server deploy. No default URL: the
# worker fails closed if the embedding service is not configured or unreachable.
EDITORIAL_CORPUS_RELEVANCE=0
# Inside terraveler_net (compose.editorial.yml); on the host use http://127.0.0.1:6002/v1/embeddings/create
EDITORIAL_EMBEDDING_URL=http://terraveler_embedding:8010/v1/embeddings/create
