# Copy outside the repository; chmod 600. These are placeholders, not credentials.
# Both gates must explicitly become 1 before work/model calls are permitted.
EDITORIAL_WORKER_ENABLED=0
EDITORIAL_HANDLERS_ENABLED=0
EDITORIAL_WORKER_ID=editorial-worker-1
EDITORIAL_HANDLER_ROLES=research,writer,reviewer

# Canonical VPS application PostgreSQL, NOT Supabase Auth or Limen's database.
# Use a dedicated LOGIN granted the worker privileges described in the runbook.
PGHOST=terraveler_postgres
PGPORT=5432
PGDATABASE=terraveler
PGUSER=terraveler_editorial_worker
PGPASSWORD=replace-with-worker-password
PGCONNECT_TIMEOUT=5
PGOPTIONS=-c statement_timeout=5000 -c lock_timeout=3000

# Docker DNS works only when compose.limen.yml is on the same terraveler network.
# Scoped Limen virtual key only; never use a provider/master/admin key here.
EDITOR_LIMEN_BASE_URL=http://terraveler_limen:4000
EDITOR_LIMEN_API_KEY=replace-with-scoped-virtual-key
EDITOR_LIMEN_DATA_CLASS=replace-with-authorized-data-class
